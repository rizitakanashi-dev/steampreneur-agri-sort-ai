# ============================================================================
# KONFIGURASI GOOGLE OAUTH 2.0 & GMAIL SMTP OTP — AGRI-SORT AI
# Salin file ini menjadi `.env` dan isi nilainya untuk mengaktifkan:
# 1. Popup Login/Daftar Google Resmi (Google Identity Services)
# 2. Pengiriman Kode OTP 6-Digit Nyata ke Inbox Gmail (Lupa Sandi & Verifikasi)
# ============================================================================

# 1. Google OAuth 2.0 Client ID (Dari Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=

# 2. Gmail SMTP untuk Mengirim Kode OTP 6-Digit ke Inbox Gmail Pengguna
# Gunakan alamat Gmail pengirim dan 16-digit Google App Password
# (Cara buat App Password: Akun Google -> Keamanan -> Verifikasi 2 Langkah -> Sandi Aplikasi)
SMTP_EMAIL=
SMTP_APP_PASSWORD=

