# Explicit runtime environment and authentication provider are required by the backend.
# Local development with file-backed Local Auth:
APP_ENV=development
AUTH_MODE=local

# To use Supabase Auth locally, set AUTH_MODE=supabase and provide both settings below.
# Production, Preview, and Staging must use AUTH_MODE=supabase; Local Auth is rejected there.
# Use the project assigned to each deployment environment. The service-role key is only for the server-side account workflow below; never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Server-only account export/deletion settings. Never expose the service key to the browser.
# Required when AUTH_MODE=supabase. Use the same project as SUPABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EXPORT_BUCKET=account-exports
# At least 32 random bytes; generate with: openssl rand -hex 32
EXPORT_HMAC_KEY=

# Optional public Google Identity Services client ID; configure the matching Google provider in Supabase Auth.
VITE_GOOGLE_CLIENT_ID=

# Mode data harga PUBLIK (isu #44): live | demo | off. Default off sampai API harga tersedia.
# live -> frontend hanya memanggil kontrak /api/v1/prices/*; demo -> acuan lokal statis berlabel;
# off  -> status integrasi belum aktif. Jangan pernah menaruh kredensial provider di sini.
VITE_PRICE_DATA_MODE=off
# Override base URL API untuk staging (publik, bukan kredensial). Kosong = same-origin /api/v1.
VITE_PRICE_API_BASE_URL=

# ----------------------------------------------------------------------------
# SERVER-ONLY (jangan pernah berawalan VITE_) — importer dataset resmi SP2KP
# (isu #39/#42): akses terkonfirmasi via dataset "Tingkat Harga Daerah" di
# data.go.id; resource XLSX bulanan api-sp2kp.kemendag.go.id (publik, tanpa
# kredensial). Flag di bawah tetap OFF default — nyalakan hanya di server.
# ----------------------------------------------------------------------------
# PRICE_SP2KP_ENABLED=false
# PRICE_INGEST_ENABLED=false
# PRICE_CRON_SECRET=
# SP2KP_DATASET_BASE_URL=                    # kosong = endpoint resmi
# SP2KP_DATASET_MONTHS_BACK=1                # bulan lampau ikut diunduh (0-3)
# SP2KP_DATASET_PROVINCE=13                  # Sumatera Barat (Payakumbuh = 1376)
