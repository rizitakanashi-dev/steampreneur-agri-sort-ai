# Public Google Identity Services client ID; must also be configured as the Google provider in Supabase Auth.
VITE_GOOGLE_CLIENT_ID=

# Supabase project settings. SUPABASE_ANON_KEY is safe for backend Auth requests; never put a service-role key in Vite variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
